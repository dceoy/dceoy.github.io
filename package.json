{
  "name": "dceoy.github.io",
  "private": true,
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix override",
    "lint": "htmlhint '**/*.html' && stylelint '**/*.css' && oxlint --no-error-on-unmatched-pattern . && biome check .",
    "lint:fix": "stylelint --fix '**/*.css' && oxlint --fix --no-error-on-unmatched-pattern . && biome check --write .",
    "format": "biome format --write . && oxfmt --write '*.md' --no-error-on-unmatched-pattern",
    "format:check": "biome format . && oxfmt --check '*.md' --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "htmlhint": "latest",
    "markdownlint-cli2": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "prettier": "latest",
    "stylelint": "latest",
    "stylelint-config-prettier": "latest",
    "stylelint-config-standard": "latest"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ]
  }
}
