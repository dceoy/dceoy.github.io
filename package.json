{
  "name": "dceoy.github.io",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix override",
    "lint": "htmlhint '**/*.html' && oxlint --no-error-on-unmatched-pattern . && biome check .",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern . && biome check --write .",
    "format": "biome format --write . && prettier --write '*.md'",
    "format:check": "biome format . && prettier --check '*.md'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "htmlhint": "^1.9.2",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6"
  }
}
