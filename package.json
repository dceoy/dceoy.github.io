{
  "name": "dceoy.github.io",
  "private": true,
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix override",
    "lint": "pnpm htmlhint '**/*.html' && pnpm stylelint '**/*.css' && pnpm oxlint --no-error-on-unmatched-pattern . && pnpm biome check --md-formatter-enabled=false .",
    "lint:fix": "pnpm stylelint --fix '**/*.css' && pnpm oxlint --fix --no-error-on-unmatched-pattern . && pnpm biome check --md-formatter-enabled=false --write .",
    "format": "pnpm biome format --md-formatter-enabled=false --write . && pnpm oxfmt --write '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "format:check": "pnpm biome format --md-formatter-enabled=false . && pnpm oxfmt --check '**/*.{md,mdx}' --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "htmlhint": "latest",
    "markdownlint-cli2": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "prettier": "latest",
    "stylelint": "latest",
    "stylelint-config-prettier": "latest",
    "stylelint-config-standard": "latest"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4",
      "onFail": "download"
    }
  }
}
